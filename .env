# Copy this file to .env and fill in real values before running.

# MySQL connection (these defaults match docker-compose.yml)
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="sunnyraavan3332"
MYSQL_DATABASE=job_agent


# App
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Job ingestion: Adzuna (free tier signup at https://developer.adzuna.com/)
# Leave blank to disable Adzuna ingestion; RemoteOK/Greenhouse/Lever need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Outreach: SMTP for sending cold emails (any provider: Gmail app password,
# SendGrid, Postmark, your own mail server...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Job Search Agent

# Outreach: optional -- if set, cold emails are drafted with the Claude API
# for more natural phrasing instead of the built-in templates. Leave blank
# to use templates only (no cost, no external dependency).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

FOLLOW_UP_AFTER_DAYS=7

# CORS: comma-separated list of allowed frontend origins in production.
# Leave as * for local development.
CORS_ORIGINS=*
